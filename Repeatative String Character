import java.util.*;
public class Main{
    public static void main(String []args)
    {
    String str="Raajj";
    int c;
    for(int i=0;i<str.length();i++)
    {
        c=0;
        for(int j=0;j<str.length();j++)
        {
            if(str.charAt(i)==str.charAt(j))
            {
                c++;
            }
        }
        if(c>1)
        {
            System.out.println(str.charAt(i));
            break;
        }
    }
    }
}
